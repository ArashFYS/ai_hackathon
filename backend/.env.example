# Copy to backend/.env. Apify API token (Apify Console > Settings > API tokens).
# Google Maps Scraper costs about $0.0075 per searched record (place + contacts + 3 reviews).
APIFY_TOKEN=

# Google Maps Platform key restricted to HTTP referrers + Maps Embed API + Places API (New). Optional: enables the place card and "Contactgegevens ophalen uit Google Maps" in the Kaart tab.
GOOGLE_MAPS_EMBED_KEY=
